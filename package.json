{
  "name": "robotik-extension",
  "displayName": "Robotik in VS Code",
  "publisher": "JulianSeckinger",
  "description": "LEGO SPIKE (Pybricks) per Knopfdruck flashen & starten – mit eigener Seitenleiste: Hubs suchen/verbinden/löschen, Live-Log, Fortschritt, Fehlerhilfe, Vorlagen und Snippets. Für die Robotik-AG des LGÖ.",
  "icon": "images/icon.png",
  "version": "0.2.0",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/anomalyco/Robotik-AG-UI.git"
  },
  "homepage": "https://github.com/anomalyco/Robotik-AG-UI#readme",
  "bugs": {
    "url": "https://github.com/anomalyco/Robotik-AG-UI/issues"
  },
  "keywords": [
    "education",
    "robotics",
    "spike",
    "pybricks",
    "lego",
    "bluetooth",
    "mindstorms"
  ],
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "robotik",
          "title": "Robotik",
          "icon": "media/robot.svg"
        }
      ]
    },
    "views": {
      "robotik": [
        {
          "type": "webview",
          "id": "robotik.sidebar",
          "name": "SPIKE-Steuerung"
        }
      ]
    },
    "commands": [
      {
        "command": "robotik-extension.downloadMainSpike",
        "title": "⬇️ Spike",
        "category": "Robotik"
      },
      {
        "command": "robotik-extension.uploadOnly",
        "title": "Nur auf Hub hochladen (ohne Start)",
        "category": "Robotik"
      },
      {
        "command": "robotik-extension.stop",
        "title": "Programm stoppen",
        "category": "Robotik"
      },
      {
        "command": "robotik-extension.scanHubs",
        "title": "Nach Hubs suchen",
        "category": "Robotik"
      },
      {
        "command": "robotik-extension.clearHubProgram",
        "title": "Programm vom Hub löschen",
        "category": "Robotik"
      },
      {
        "command": "robotik-extension.newFromTemplate",
        "title": "Neues Programm aus Vorlage",
        "category": "Robotik"
      },
      {
        "command": "robotik-extension.checkEnvironment",
        "title": "Umgebung prüfen / reparieren",
        "category": "Robotik"
      },
      {
        "command": "robotik-extension.openPanel",
        "title": "Steuerung öffnen",
        "category": "Robotik"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "robotik-extension.downloadMainSpike"
        },
        {
          "command": "robotik-extension.uploadOnly"
        },
        {
          "command": "robotik-extension.stop"
        },
        {
          "command": "robotik-extension.scanHubs"
        },
        {
          "command": "robotik-extension.clearHubProgram"
        },
        {
          "command": "robotik-extension.newFromTemplate"
        },
        {
          "command": "robotik-extension.checkEnvironment"
        },
        {
          "command": "robotik-extension.openPanel"
        }
      ],
      "editor/title": [
        {
          "command": "robotik-extension.downloadMainSpike",
          "group": "navigation",
          "when": "resourceLangId == python"
        }
      ]
    },
    "keybindings": [
      {
        "command": "robotik-extension.downloadMainSpike",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorLangId == python"
      }
    ],
    "snippets": [
      {
        "language": "python",
        "path": "./snippets/pybricks.json"
      }
    ],
    "configuration": {
      "title": "Robotik",
      "properties": {
        "robotik.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Optional: Pfad zu einem eigenen Python (>= 3.10) mit pybricksdev. Leer = automatische eigene Umgebung."
        },
        "robotik.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Datei vor dem Upload automatisch speichern."
        },
        "robotik.autoRunOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Beim Speichern der zuletzt genutzten .py-Datei automatisch hochladen und starten."
        },
        "robotik.clearLogOnRun": {
          "type": "boolean",
          "default": true,
          "description": "Live-Log vor jedem Start leeren."
        },
        "robotik.scanTimeout": {
          "type": "number",
          "default": 6,
          "minimum": 2,
          "maximum": 30,
          "description": "Dauer der Bluetooth-Suche in Sekunden."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.2",
    "eslint": "^9.32.0"
  }
}